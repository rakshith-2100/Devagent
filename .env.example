# ---- Model provider -------------------------------------------------------
# bedrock (default) | mock (offline, scripted responses for testing the loop)
DEVAGENT_MODEL_PROVIDER=bedrock

# Bedrock API key (long-term key from the Bedrock console) OR a short-term
# bearer token. Either variable works; BEDROCK_API_KEY wins if both are set.
BEDROCK_API_KEY=
# AWS_BEARER_TOKEN_BEDROCK=

AWS_REGION=us-east-1
# Bedrock model ids carry an "anthropic." prefix. Depending on your account you
# may need a cross-region inference profile id instead (prefix "us." / "eu.").
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# Optional: SigV4 credentials (used only if no bearer token is set; needs boto3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Insert Converse cachePoint blocks after the static system prompt and tools.
# Leave off until you have confirmed the model/region supports prompt caching.
BEDROCK_PROMPT_CACHE=0
# JSON merged into additionalModelRequestFields (model-specific knobs).
# BEDROCK_EXTRA_FIELDS={}

DEVAGENT_MAX_OUTPUT_TOKENS=8192
# DEVAGENT_TEMPERATURE=            # leave unset; current Claude models reject sampling params
DEVAGENT_REQUEST_TIMEOUT=180
DEVAGENT_MAX_RETRIES=5          # per model call; free/shared endpoints are often "temporarily overloaded"

# ---- Cost estimate (USD per million tokens; Bedrock pricing differs from 1P) --
DEVAGENT_PRICE_IN_PER_M=4.0
DEVAGENT_PRICE_OUT_PER_M=20.0
DEVAGENT_PRICE_CACHE_READ_PER_M=0.4
DEVAGENT_PRICE_CACHE_WRITE_PER_M=5.0

# ---- Budgets ----------------------------------------------------------------
DEVAGENT_MAX_STEPS=25
DEVAGENT_MAX_TOKENS=400000
DEVAGENT_MAX_COST_USD=1.00
DEVAGENT_MAX_WALL_SECONDS=600

# ---- Context ----------------------------------------------------------------
DEVAGENT_CONTEXT_WINDOW=200000
DEVAGENT_COMPACTION_RATIO=0.70
DEVAGENT_KEEP_RECENT=8
DEVAGENT_REPOMAP_TOKENS=3000

# ---- Behaviour ---------------------------------------------------------------
# default | careful | yolo
DEVAGENT_MODE=default
DEVAGENT_ENABLE_DELEGATE=0
DEVAGENT_USE_WORKTREE=1
DEVAGENT_LOG_PROMPTS=1
DEVAGENT_MAX_TEST_ATTEMPTS=3

# ---- OpenRouter (OpenAI-compatible; DEVAGENT_MODEL_PROVIDER=openrouter or --provider openrouter) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
